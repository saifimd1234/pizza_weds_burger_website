# ── WhatsApp Cloud API (Meta) ───────────────────────────────
# From developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=            # System User permanent token (not the 24h temp token)
WHATSAPP_APP_SECRET=              # App settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_VERIFY_TOKEN=            # any random string you invent; paste the same in Meta's webhook config
WHATSAPP_GRAPH_VERSION=v25.0

# Staff WhatsApp numbers (country code, digits only, comma-separated). They receive order alerts
# with Accept/Preparing/Delivered buttons.
STAFF_WHATSAPP_NUMBERS=

# Optional approved templates (needed only when the 24h chat window is closed)
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_ORDER_UPDATE=   # body: "Update on order {{1}}: {{2}}"
WHATSAPP_TEMPLATE_STAFF_ORDER=    # 5 body vars + 2 quick-reply buttons (see docs/WHATSAPP_SETUP.md)

# ── AI ──────────────────────────────────────────────────────
# AI Gateway key locally (on Vercel it uses OIDC automatically). `vercel env pull` fills this.
AI_GATEWAY_API_KEY=
AGENT_MODEL=anthropic/claude-haiku-5.5

# ── Database: Supabase → Connect → Transaction pooler URI (port 6543) ──
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Staff board (/admin, user "admin") ──────────────────────
ADMIN_PASSWORD=
